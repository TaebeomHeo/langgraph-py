# =============================================================================
# LLM 설정
# =============================================================================

# OpenAI 설정 (선택사항 - 없으면 Ollama 사용)
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Ollama 설정 (OpenAI가 없을 때 사용)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:latest

# =============================================================================
# 도구 설정
# =============================================================================

# Tavily 검색 설정 (선택사항 - 없으면 검색 기능 비활성화)
TAVILY_API_KEY=tvly-your-tavily-api-key-here
TAVILY_MAX_RESULTS=5

# =============================================================================
# 파일 및 디렉토리 설정
# =============================================================================

# 작업 디렉토리 (기본값: ./)
WORKSPACE_DIR=./

# 데이터베이스 파일명 (기본값: advanced_pattern.db)
DB_FILE=advanced_pattern.db

# 스레드 추적 파일명 (기본값: active_threads.json)
THREADS_FILE=active_threads.json

# Clear 시 삭제할 추가 DB 파일들 (쉼표로 구분, 필요시에만 설정)
# ADDITIONAL_DB_FILES=old_chatbot.db,backup.db

# =============================================================================
# UI 및 표시 설정
# =============================================================================

# 스레드 ID 생성 설정
THREAD_ID_PREFIX=thread
THREAD_ID_LENGTH=8

# 표시 길이 설정
SEARCH_RESULT_PREVIEW_LENGTH=500
HISTORY_DISPLAY_LIMIT=10
MESSAGE_PREVIEW_LENGTH=50

# 메시지 커스터마이징
INTERRUPT_MESSAGE=🔄 Human input이 필요합니다. 현재 스레드가 일시정지됩니다...
NEW_THREAD_MESSAGE=🆕 새로운 스레드에서 메시지를 처리합니다...

# =============================================================================
# LangChain 추적 설정 (선택사항)
# =============================================================================

# LangSmith 추적 활성화 (기본값: false)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your-langsmith-api-key-here

# =============================================================================
# 디버그 설정
# =============================================================================

# 디버그 모드 활성화 (기본값: false)
DEBUG_MODE=false

# 그래프 chunk 디버그 출력 (기본값: false)
SHOW_CHUNK_DEBUG=false 